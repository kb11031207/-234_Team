# Database
DATABASE_URL=sqlite+aiosqlite:///./test.db

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string_here
AZURE_STORAGE_CONTAINER_NAME=event-media

# Firebase Admin SDK
# Download your Firebase service account JSON from:
# Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Save it to backend/ directory and update the path below
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Security
SECRET_KEY=your-secret-key-here-use-openssl-rand-hex-32

# Environment
ENVIRONMENT=development

# Face Recognition
FACE_RECOGNITION_MODEL=small
FACE_RECOGNITION_TOLERANCE=0.6
